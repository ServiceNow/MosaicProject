# Copy this file to a local, ignored environment file before launching.
# Fill in local paths and credentials there.

MOSAICLEAKS_DATASET_BUNDLE=/path/to/published_mosaicleaks_dataset
MOSAICLEAKS_RETRIEVAL_HELPER_URL=http://127.0.0.1:8012

TRAIN_ROOT=/path/to/external/training/repo
TRAIN_ENTRYPOINT=pipelinerl.launch
TRAIN_CONFIG_NAME=mosaicleaks
TRAIN_CONFIG_DIR=/path/to/external/training/repo/conf

MODEL_PATH=Qwen/Qwen3-4B-Instruct-2507
OUTPUT_DIR_BASE=outputs/training
RUN_NAME=mosaicleaks_example_run

CAPTURE_MODE=planning_only
TRAIN_LEARNING_RATE=1e-6
TRAIN_POLICY_LOSS=gspo
TRAIN_SEQ_LENGTH=16384
TRAIN_MAX_TOKENS=4096
TRAIN_MAX_ROLLOUTS=32

# Optional file containing one trainer override per line.
TRAIN_EXTRA_OVERRIDES_FILE=
