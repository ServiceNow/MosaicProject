# OpenRouter judge-validation smoke config.
# This file intentionally does not contain the API key.

OPENROUTER_ENV_FILE=/home/toolkit/my_code/openkey.env

# Override if OpenRouter uses a different slug for Opus 4.7.
OPENROUTER_MODEL=anthropic/claude-opus-4.7

SAMPLE_DIR=/home/toolkit/my_code/MosaicProject/runtime_analysis/privacy_hopqa_q30_stepfun_judge_validation_cross_model_200_20260525
LIMIT=3
CONCURRENCY=1
SAMPLE_MODE=spread
RANDOM_SEED=20260525
MAX_TOKENS=16384
TEMPERATURE=0

# Anthropic/OpenRouter chat endpoints may reject OpenAI response_format.
DISABLE_RESPONSE_FORMAT=1

# Checks account/key status before and after the smoke. This is not a model call.
CHECK_CREDITS=1
